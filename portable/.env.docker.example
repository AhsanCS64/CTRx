# Copy to .env.docker; never commit the populated file.
# --env-file supplies Compose interpolation as well as service environment.
CTRX_HTTP_PORT=8080
# development permits refresh cookies on plain HTTP localhost. For public HTTPS
# use production, HTTPS URLs below, and a TLS reverse proxy.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://USER:URL_ENCODED_PASSWORD@HOST:5432/DB?sslmode=require
# Required by existing settings; must be a separate disposable database.
TEST_DATABASE_URL=postgresql+psycopg://USER:URL_ENCODED_PASSWORD@TEST_HOST:5432/ctrx_test?sslmode=require
JWT_SECRET_KEY=replace-with-random-secret
HMAC_SECRET=replace-with-another-random-secret
# Fernet key; retain the existing key for an existing encrypted database.
ENCRYPTION_KEY=replace-with-fernet-key
SEED_PASSWORD=
CORS_ORIGINS=["http://localhost:8080"]
FRONTEND_BASE_URL=http://localhost:8080
VERIFY_BASE_URL=http://localhost:8080/api/verify
DEMO_ALLOW_UNVERIFIED_PASSWORD_RESET=false
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
PASSWORD_RESET_EXPIRE_MINUTES=20
# Used only with docker-compose.local.yml; set a random value.
POSTGRES_PASSWORD=replace-with-local-only-password
