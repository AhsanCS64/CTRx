APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://ctrx_app:YOUR_PASSWORD@localhost:5432/ctrx
TEST_DATABASE_URL=postgresql+psycopg://ctrx_app:YOUR_PASSWORD@localhost:5432/ctrx
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
HMAC_SECRET=
ENCRYPTION_KEY=
# Required for the one-time first administrator setup and optional demo seed accounts.
SEED_PASSWORD=
CORS_ORIGINS=http://localhost:5173
STORAGE_DIR=./storage
VERIFY_BASE_URL=
FRONTEND_BASE_URL=http://localhost:5173
# Preferred for hosted services that block SMTP. Use a sender on a verified domain.
RESEND_API_KEY=
EMAIL_FROM=
# Local development: run a local SMTP inbox such as Mailpit on localhost:1025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@ctrx.local
SMTP_USE_SSL=false
SMTP_STARTTLS=false
PASSWORD_RESET_EXPIRE_MINUTES=20
# Demo only: permits changing a password using only the account email.
DEMO_ALLOW_UNVERIFIED_PASSWORD_RESET=true
